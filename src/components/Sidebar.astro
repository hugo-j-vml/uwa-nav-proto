---
/**
 * Sidebar shell (variants D and E): fixed on the left, in place of the header.
 * Logo (on a co-branded site's pages, the site's logo placeholder under it),
 * a search field, then either the top-level items (D) or a Menu button
 * and the header shortcuts (E). The drill-down pane opens to its right; it is
 * drawn by src/scripts/sidebar-menu.ts from the sitemap data embedded below.
 * On a co-branded site's pages, D also gets the site's own list (shown in place
 * of the top-level items for behaviour option "Co-brand menu" = 2, with tabs
 * to swap between the two; CSS decides which shows), and the site's name and
 * sections at the top of the top-level list, above a divider (option 7; also
 * shown by CSS).
 * Compact layouts (mobile and tablet): a top bar (hamburger, horizontal logo,
 * the co-brand logo placeholder on co-branded pages, search) replaces the
 * sidebar's logos, and the sidebar becomes a drawer that slides in from the
 * left under the bar, over a scrim. The drill-down pane then opens over the
 * drawer, a level deeper.
 */
import Icon from './Icons.astro';
import { nodes, shortcuts, href, variantBase, base, cobrandData, type Cobrand } from '../lib/nav';

interface Props { variant: string; menu: string; currentPath?: string; cobrand?: Cobrand }
const { variant, menu, currentPath = '', cobrand } = Astro.props;
const site = cobrand?.site.length ? cobrand : undefined;

type Compact = { l: string; p: string; c: Compact[] };
const compact = (list: typeof nodes): Compact[] => list.map(n => ({ l: n.label, p: n.path, c: compact(n.children) }));
const data = JSON.stringify({ base: variantBase(variant), tree: compact(nodes), cobrand: site ? cobrandData(site) : undefined }).replace(/</g, '\\u003c');
---
{/* Compact layouts only (hidden on desktop by CSS) */}
<div class="mobile-bar" data-mobile-bar>
  <button class="mobile-bar-button" type="button" aria-expanded="false" aria-controls="sidebar" aria-label="Menu" data-drawer-toggle>
    <span class="icon-closed"><Icon name="menu" /></span>
    <span class="icon-open"><Icon name="menu-open" /></span>
  </button>
  <a class="mobile-bar-logo" href={href('', variant)}><img src={`${base}logos/uwa-horizontal.svg`} alt="The University of Western Australia: home" width="216" height="71" /></a>
  {cobrand && <a class="cobrand-logo" href={cobrand.href} aria-label={`${cobrand.label}: home`}><span aria-hidden="true">Co-brand<br />Logo</span></a>}
  <button class="mobile-bar-button mobile-bar-search" type="button" aria-label="Search (not available in this prototype)" data-bar-search><Icon name="search" /></button>
</div>
<div class="drawer-scrim" data-drawer-scrim hidden></div>

<aside id="sidebar" class:list={['sidebar', { 'has-cobrand': site }]} data-sidebar data-current-path={currentPath} data-menu-layout={menu}>
  <a class="sidebar-logo" href={href('', variant)}><img src={`${base}logos/uwa-vertical.svg`} alt="The University of Western Australia: home" width="94" height="162" /></a>
  {cobrand && <a class="cobrand-logo sidebar-cobrand-logo" href={cobrand.href} aria-label={`${cobrand.label}: home`}><span aria-hidden="true">Co-brand<br />Logo</span></a>}

  <form class="sidebar-search" role="search" data-sidebar-search>
    <label class="visually-hidden" for="sidebar-search-input">Search</label>
    <input id="sidebar-search-input" type="search" placeholder="Search" autocomplete="off" />
    <button type="submit" aria-label="Search"><Icon name="search" /></button>
  </form>

  {menu === 'drilldown' ? (
    <>
    {/* Option 2: tabs for the site's menu and the UWA main menu (same markup as src/lib/menu-tabs.ts; CSS shows them for option 2 only) */}
    {site && (
      <div class="menu-tabs sidebar-tabs" role="tablist" aria-label="Menus" data-sidebar-tabs>
        <button class="menu-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-switch="core" aria-label="UWA main menu">UWA</button>
        <button class="menu-tab" type="button" role="tab" aria-selected="true" data-switch="cobrand" aria-label={site.abbreviation ? site.label : undefined}>{site.abbreviation || site.label}</button>
      </div>
    )}
    <nav aria-label="Main menu">
      <ul class="sidebar-list" data-sidebar-list>
        {site && (
          <>
            <li class="sidebar-cobrand-item"><a class="sidebar-site-title" href={site.href} aria-current={currentPath === site.path ? 'page' : undefined}>{site.label}</a></li>
            {site.site.map((sec, i) => (
              <li class="sidebar-cobrand-item">
                <button class="sidebar-item" type="button" data-path={`~${i}`} aria-expanded="false" aria-controls="drill-pane">
                  <span>{sec.label}</span><Icon name="arrow" />
                </button>
              </li>
            ))}
            <li class="sidebar-cobrand-item sidebar-divider" role="separator"></li>
          </>
        )}
        {nodes.map(n => (
          <li>
            {n.children.length ? (
              <button class="sidebar-item" type="button" data-path={n.path} aria-expanded="false" aria-controls="drill-pane">
                <span>{n.label}</span><Icon name="arrow" />
              </button>
            ) : (
              <a class="sidebar-item" href={href(n.path, variant)}><span>{n.label}</span></a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    {site && (
      <nav class="sidebar-cobrand" aria-label={`${site.label} menu`}>
        <a class="sidebar-site-title" href={site.href} aria-current={currentPath === site.path ? 'page' : undefined}>{site.label}</a>
        <ul class="sidebar-list">
          {site.site.map((sec, i) => (
            <li>
              <button class="sidebar-item" type="button" data-path={`~${i}`} aria-expanded="false" aria-controls="drill-pane">
                <span>{sec.label}</span><Icon name="arrow" />
              </button>
            </li>
          ))}
        </ul>
      </nav>
    )}
    </>
  ) : (
    <>
      <button class="sidebar-menu-button" type="button" aria-expanded="false" aria-controls="drill-pane" data-menu-toggle>
        <Icon name="menu" />
        <span>Menu</span>
      </button>
      <nav class="sidebar-shortcuts" aria-label="Shortcuts" data-cobrand={cobrand ? '' : undefined}>
        {shortcuts.map(s => <a class="sidebar-shortcut" href={href(s.path, variant)}>{s.label}</a>)}
      </nav>
    </>
  )}
</aside>

<nav id="drill-pane" class="drill-pane" aria-label="Main menu" hidden>
  <button class="drill-back" type="button" data-drill-back hidden><Icon name="arrow" /><span>Back</span></button>
  <ul class="menu-list" data-drill-list></ul>
</nav>

<template data-arrow><Icon name="arrow" /></template>
<script type="application/json" data-nav-data set:html={data}></script>

<script>
  import '../scripts/sidebar-menu.ts';
</script>
