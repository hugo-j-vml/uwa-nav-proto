---
/**
 * Stand-in page template (homepage layout from Figma) until the content page
 * templates arrive: two placeholder blocks with the page title over the first.
 */
import Placeholder from './Placeholder.astro';
import { href } from '../lib/nav';

interface Props {
  title: string;
  crumbs?: { label: string; path: string }[];
  note?: string;
}
const { title, crumbs = [], note } = Astro.props;
---
<Placeholder />
<Placeholder />
<div class="page-heading">
  {crumbs.length > 0 && (
    <ol class="breadcrumb" aria-label="Breadcrumb">
      <li><a href={href('')}>Home</a></li>
      {crumbs.map(c => <li><a href={href(c.path)}>{c.label}</a></li>)}
    </ol>
  )}
  <h1 class="page-title">{title}</h1>
  {note && <p class="page-note">{note}</p>}
</div>
