---
/**
 * Simple password screen. NOT real security: it only keeps casual visitors
 * out. The password is checked against a SHA-256 hash in src/config.ts and
 * remembered in this browser once entered.
 */
import { PASSWORD_SHA256, PROTOTYPE_NAME } from '../config';
---
<div class="gate" role="dialog" aria-labelledby="gate-title">
  <form data-gate-form>
    <h1 id="gate-title">{PROTOTYPE_NAME}</h1>
    <p>Enter the password to view this prototype.</p>
    <label class="visually-hidden" for="gate-password">Password</label>
    <input id="gate-password" type="password" autocomplete="current-password" required />
    <button type="submit">Enter</button>
    <p class="gate-error" aria-live="polite" data-gate-error></p>
  </form>
</div>

<script is:inline define:vars={{ hash: PASSWORD_SHA256 }}>
  (function () {
    var KEY = 'uwa-nav-proto-auth';
    var form = document.querySelector('[data-gate-form]');
    if (!form) return;
    async function sha256(text) {
      var buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
    }
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var input = document.getElementById('gate-password');
      if ((await sha256(input.value)) === hash) {
        try { localStorage.setItem(KEY, hash); } catch (err) {}
        document.documentElement.classList.remove('is-locked');
      } else {
        document.querySelector('[data-gate-error]').textContent = 'That password is not right.';
        input.select();
      }
    });
    if (document.documentElement.classList.contains('is-locked')) {
      document.getElementById('gate-password').focus();
    }
  })();
</script>
