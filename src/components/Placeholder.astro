---
/**
 * Wireframe image placeholder: filled box with a cross (Figma "Component" placeholders).
 * Size it with CSS. `full` keeps the 1440 x 808 ratio; `sage` uses the co-branded fill.
 */
interface Props { class?: string; full?: boolean; sage?: boolean; short?: boolean }
const { class: extra = '', full = false, sage = false, short = false } = Astro.props;
const cls = ['placeholder', full && 'full', sage && 'sage', short && 'short', extra].filter(Boolean).join(' ');
---
<svg class={cls} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <rect x="0" y="0" width="100" height="100" />
  <line x1="0" y1="0" x2="100" y2="100" />
  <line x1="100" y1="0" x2="0" y2="100" />
</svg>
