---
/** Breadcrumbs (Figma "Breadcrumbs"): UWA › ancestors › current page (not a link). */
interface Props { home: string; crumbs: { label: string; href: string }[]; current: string }
const { home, crumbs, current } = Astro.props;
---
<nav aria-label="Breadcrumb">
  <ol class="breadcrumb">
    <li><a href={home}>UWA</a></li>
    {crumbs.map(c => <li><a href={c.href}>{c.label}</a></li>)}
    <li aria-current="page">{current}</li>
  </ol>
</nav>
