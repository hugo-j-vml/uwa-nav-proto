---
/**
 * Index page: lists the nav concepts (variants) with links. Behind the
 * password screen. Layout and colours from Hugo's reference (dark page,
 * rule under the mark, intro top left, large lettered list); the typeface is
 * a plain stand-in for now (--index-font in tokens.css).
 */
import Base from '../layouts/Base.astro';
import { variantBase } from '../lib/nav';
import { variants } from '../variants';
import VmlMark from '../components/VmlMark.astro';
import IndexFooter from '../components/IndexFooter.astro';
import OptionsControls from '../components/OptionsControls.astro';
---
<Base title="Variants">
  <div class="index-page">
    <header class="index-header">
      <VmlMark />
    </header>
    <main class="index-main">
      <p class="index-intro">UWA main navigation prototypes<br />Choose a concept to continue!</p>
      <ol class="index-list">
        {variants.map(v => (
          <li class:list={['index-item', { 'is-coming-soon': v.status !== 'ready' }]}>
            {v.status === 'ready' ? (
              <a class="index-link" href={variantBase(v.id)} target="_blank" rel="noopener">
                <span class="index-letter">{v.letter}.</span>
                <span class="index-name">{v.name}</span>
              </a>
            ) : (
              <span class="index-link" aria-disabled="true">
                <span class="index-letter">{v.letter}.</span>
                <span class="index-name">{v.name}<span class="index-tag">Coming soon</span></span>
              </span>
            )}
          </li>
        ))}
      </ol>
      <section class="index-options" aria-labelledby="index-options-title">
        <h2 id="index-options-title" class="index-options-title">Options</h2>
        <p class="index-options-note">Alternative behaviours, applied to every concept in this browser. Shift+O on any concept page opens the same switches.</p>
        <OptionsControls />
      </section>
    </main>
    <IndexFooter />
  </div>
</Base>
