---
/**
 * Every page of every built variant: the variant's homepage, one page per
 * sitemap item (rendered with the template set in the sitemap CSV: landing /
 * content / course / cobranded), and stand-in landing pages for header
 * shortcuts that aren't in the sitemap.
 */
import Base from '../../layouts/Base.astro';
import Landing from '../../templates/Landing.astro';
import Content from '../../templates/Content.astro';
import Course from '../../templates/Course.astro';
import CoBranded from '../../templates/CoBranded.astro';
import CoBrandedPage from '../../templates/CoBrandedPage.astro';
import { flatten, ancestors, standalonePages, sitePages, href, type NavNode, type SiteNode } from '../../lib/nav';
import { builtVariants } from '../../variants';

export function getStaticPaths() {
  return builtVariants.flatMap(variant => {
    const home = {
      params: { variant: variant.id, page: undefined },
      props: { variant, node: undefined as NavNode | undefined, title: 'Homepage', note: undefined as string | undefined, sitePage: undefined },
    };
    const fromSitemap = flatten().map(n => ({
      params: { variant: variant.id, page: n.path },
      props: { variant, node: n as NavNode | undefined, title: n.label, note: undefined as string | undefined, sitePage: undefined as { page: SiteNode; root: NavNode; parent?: SiteNode } | undefined },
    }));
    // Pages in co-branded sites' own menus (not in the main menu)
    const fromSites = sitePages().map(sp => ({
      params: { variant: variant.id, page: sp.page.path },
      props: { variant, node: undefined, title: sp.page.label, note: undefined, sitePage: sp },
    }));
    const standalone = standalonePages().map(s => ({
      params: { variant: variant.id, page: s.path },
      props: { variant, node: undefined, title: s.label, note: 'Stand-in landing page: this header shortcut is not in the sitemap yet.', sitePage: undefined },
    }));
    return [home, ...fromSitemap, ...fromSites, ...standalone];
  });
}

const { variant, node, title, note, sitePage } = Astro.props;
const template = sitePage ? 'cobranded-page' : (node?.template ?? 'landing');
const home = href('', variant.id);
// Co-branded site pages (the site's home and the pages in its own IA): name and home URL for the header lockup
const cobrandRoot = template === 'cobranded' ? node : sitePage?.root;
const cobrand = cobrandRoot ? { label: cobrandRoot.label, path: cobrandRoot.path, href: href(cobrandRoot.path, variant.id), site: cobrandRoot.site ?? [], abbreviation: cobrandRoot.abbreviation } : undefined;
const crumbs = node ? ancestors(node.path).map(a => ({ label: a.label, href: href(a.path, variant.id) })) : [];
// "In this section": the page's children, when they're deeper than the variant's menu goes (e.g. C stops at L3)
const section = node && variant.menuDepth && node.level >= variant.menuDepth
  ? node.children.map(c => ({ label: c.label, href: href(c.path, variant.id) }))
  : [];
---
<Base title={title} variant={variant} currentPath={node?.path ?? sitePage?.page.path ?? ''} transparentHeader={template === 'landing'} cobrand={cobrand}>
  {template === 'landing' && <Landing title={title} note={note} />}
  {template === 'content' && <Content title={title} home={home} crumbs={crumbs} section={section} />}
  {template === 'course' && <Course title={title} eyebrow={node?.eyebrow} intro={node?.intro} body={node?.body} />}
  {template === 'cobranded' && <CoBranded title={title} home={home} root={node!} variant={variant.id} />}
  {sitePage && <CoBrandedPage title={title} home={home} variant={variant.id} {...sitePage} />}
</Base>
