---
/**
 * Every page of every built variant: the variant's homepage, one page per
 * sitemap item (rendered with the template set in the sitemap CSV: landing /
 * content / course / cobranded), and stand-in landing pages for header
 * shortcuts that aren't in the sitemap.
 */
import Base from '../../layouts/Base.astro';
import Landing from '../../templates/Landing.astro';
import Content from '../../templates/Content.astro';
import Course from '../../templates/Course.astro';
import CoBranded from '../../templates/CoBranded.astro';
import { flatten, ancestors, standalonePages, href, type NavNode } from '../../lib/nav';
import { builtVariants } from '../../variants';

export function getStaticPaths() {
  return builtVariants.flatMap(variant => {
    const home = {
      params: { variant: variant.id, page: undefined },
      props: { variant, node: undefined as NavNode | undefined, title: 'Homepage', note: undefined as string | undefined },
    };
    const fromSitemap = flatten().map(n => ({
      params: { variant: variant.id, page: n.path },
      props: { variant, node: n as NavNode | undefined, title: n.label, note: undefined as string | undefined },
    }));
    const standalone = standalonePages().map(s => ({
      params: { variant: variant.id, page: s.path },
      props: { variant, node: undefined, title: s.label, note: 'Stand-in landing page: this header shortcut is not in the sitemap yet.' },
    }));
    return [home, ...fromSitemap, ...standalone];
  });
}

const { variant, node, title, note } = Astro.props;
const template = node?.template ?? 'landing';
const home = href('', variant.id);
const crumbs = node ? ancestors(node.path).map(a => ({ label: a.label, href: href(a.path, variant.id) })) : [];
---
<Base title={title} variant={variant} currentPath={node?.path ?? ''} transparentHeader={template === 'landing'}>
  {template === 'landing' && <Landing title={title} note={note} />}
  {template === 'content' && <Content title={title} home={home} crumbs={crumbs} />}
  {template === 'course' && <Course title={title} eyebrow={node?.eyebrow} intro={node?.intro} body={node?.body} />}
  {template === 'cobranded' && <CoBranded title={title} home={home} crumbs={crumbs} />}
</Base>
