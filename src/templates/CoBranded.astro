---
/**
 * Co-branded site home page (Figma "Co-branded site page template"). Short
 * breadcrumb (UWA › site name), then the sage hero with the title.
 */
import Placeholder from '../components/Placeholder.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props { title: string; home: string }
const { title, home } = Astro.props;
---
<div class="tpl-cobranded">
  <div class="page-intro">
    <Breadcrumbs home={home} crumbs={[]} current={title} />
  </div>
  <div class="cobranded-hero">
    <Placeholder sage />
    <h1 class="cobranded-title">{title}</h1>
  </div>
  <div class="cobranded-tiles">
    <Placeholder sage />
    <Placeholder sage />
  </div>
  <div class="placeholder-stack">
    <Placeholder full />
  </div>
</div>
