---
/**
 * Course page template (Figma "Course page template").
 * Eyebrow, intro and body come from the sitemap CSV columns; if blank, the
 * Figma example copy is used.
 */
import Placeholder from '../components/Placeholder.astro';
interface Props { title: string; eyebrow?: string; intro?: string; body?: string }
const FALLBACK = {
  eyebrow: 'Undergraduate',
  intro: 'Grow your creative, ecological, and design skills together in the Landscape Architecture Studies major while tailoring your studies in other areas that matter to you.',
  body: "In the Landscape Architecture Studies major, explore new ways of thinking about the landscape around you and have the flexibility to shape your degree by combining this with another area of interest. You'll develop creative, critical and ecologically-focused design skills and tailor your study path across disciplines that matter to you.",
};
const { title, eyebrow = FALLBACK.eyebrow, intro = FALLBACK.intro, body = FALLBACK.body } = Astro.props;
---
<div class="tpl-course">
  <div class="course-hero">
    <Placeholder />
    <div class="course-hero-content">
      <p class="course-eyebrow">{eyebrow}</p>
      <h1 class="page-title">{title}</h1>
      <p class="course-intro">{intro}</p>
      <div class="course-actions">
        <button type="button" class="course-button enquire">Enquire</button>
        <button type="button" class="course-button apply">Apply</button>
      </div>
    </div>
  </div>
  <div class="course-main">
    <div class="course-tabs">In page nav tabs</div>
    <p class="course-body">{body}</p>
    <div class="course-cards">
      <div class="col"><Placeholder /><Placeholder /></div>
      <div class="col"><Placeholder short /><Placeholder /></div>
      <div class="col"><Placeholder /><Placeholder /></div>
    </div>
  </div>
</div>
