---
import '@fontsource/inter/400.css';
import '@fontsource/crimson-pro/600.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';
import PrimaryNavHeader from '../components/PrimaryNavHeader.astro';
import Sidebar from '../components/Sidebar.astro';
import PasswordGate from '../components/PasswordGate.astro';
import { PASSWORD_SHA256, PROTOTYPE_NAME } from '../config';
import { OPTIONS, OPTIONS_KEY } from '../options';
import OptionsPanel from '../components/OptionsPanel.astro';
import type { Variant } from '../variants';
import type { Cobrand } from '../lib/nav';

/** variant: the nav concept this page belongs to; omit for pages outside the variants (the index page) */
/** currentPath: sitemap path of this page (e.g. 'study-at-uwa/explore-courses'), used to open the menu at the right place */
/** transparentHeader: no grey band behind the header (homepage and landing pages, per Figma) */
/** cobrand: on a co-branded site's pages, the site (A, B, C header shows its logo next to UWA's; the menus use its IA for the co-brand menu options) */
interface Props { title: string; variant?: Variant; currentPath?: string; transparentHeader?: boolean; cobrand?: Cobrand }
const { title, variant, currentPath = '', transparentHeader = false, cobrand } = Astro.props;
---
<!doctype html>
<html lang="en-AU" data-variant={variant?.id ?? 'index'} data-shell={variant?.shell}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{variant ? `${variant.letter} | ${title}` : `${title} | ${PROTOTYPE_NAME}`}</title>
    <!-- Lock the page before it paints unless the password was already entered in this browser (shared by all variants) -->
    <script is:inline define:vars={{ hash: PASSWORD_SHA256 }}>
      (function () {
        var ok = false;
        try { ok = localStorage.getItem('uwa-nav-proto-auth') === hash; } catch (e) {}
        if (!ok) document.documentElement.classList.add('is-locked');
      })();
    </script>
    <!-- Behaviour options (src/options.ts): apply the chosen ones before the page paints.
         A link like ?cobrand-menu=7 sets and remembers a choice (then drops it from the address). -->
    <script is:inline define:vars={{ options: OPTIONS.map(o => ({ id: o.id, d: o.default, c: o.choices.map(c => c.id) })), key: OPTIONS_KEY }}>
      (function () {
        var saved = {};
        try { saved = JSON.parse(localStorage.getItem(key) || '{}') || {}; } catch (e) {}
        var params = new URLSearchParams(location.search), changed = false;
        options.forEach(function (o) {
          var fromUrl = params.get(o.id);
          if (fromUrl && o.c.indexOf(fromUrl) !== -1) { saved[o.id] = fromUrl; changed = true; }
          params.delete(o.id);
          var v = o.c.indexOf(saved[o.id]) !== -1 ? saved[o.id] : o.d;
          document.documentElement.setAttribute('data-opt-' + o.id, v);
        });
        if (changed) try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {}
        // Drop the option from the address once remembered, so a later change (e.g. in the Shift+O panel) isn't undone on reload
        if (changed) { var q = params.toString(); history.replaceState(history.state, '', location.pathname + (q ? '?' + q : '') + location.hash); }
      })();
    </script>
  </head>
  <body>
    <PasswordGate />
    {variant ? (
      <div class="site">
        {/* Variant shell: header across the top (A, B, C) or a fixed sidebar (D, E) */}
        {variant.shell === 'header' && <PrimaryNavHeader variant={variant.id} menu={variant.menu} currentPath={currentPath} transparent={transparentHeader} cobrand={cobrand} />}
        {variant.shell === 'sidebar' && <Sidebar variant={variant.id} menu={variant.menu} currentPath={currentPath} cobrand={cobrand} />}
        <main class="page">
          <slot />
        </main>
        <OptionsPanel />
      </div>
    ) : (
      <slot />
    )}
  </body>
</html>
