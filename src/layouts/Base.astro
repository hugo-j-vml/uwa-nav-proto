---
import '@fontsource/inter/400.css';
import '@fontsource/crimson-pro/600.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';
import PrimaryNavHeader from '../components/PrimaryNavHeader.astro';
import PasswordGate from '../components/PasswordGate.astro';
import { PASSWORD_SHA256, PROTOTYPE_NAME } from '../config';

/** currentPath: sitemap path of this page (e.g. 'study/study-areas'), used to open the menu at the right place */
/** transparentHeader: no grey band behind the header (homepage and landing pages, per Figma) */
interface Props { title: string; currentPath?: string; transparentHeader?: boolean }
const { title, currentPath = '', transparentHeader = false } = Astro.props;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {PROTOTYPE_NAME}</title>
    <!-- Lock the page before it paints unless the password was already entered in this browser -->
    <script is:inline define:vars={{ hash: PASSWORD_SHA256 }}>
      (function () {
        var ok = false;
        try { ok = localStorage.getItem('uwa-nav-proto-auth') === hash; } catch (e) {}
        if (!ok) document.documentElement.classList.add('is-locked');
      })();
    </script>
  </head>
  <body>
    <PasswordGate />
    <div class="site">
      <PrimaryNavHeader currentPath={currentPath} transparent={transparentHeader} />
      <main class="page">
        <slot />
      </main>
    </div>
  </body>
</html>
