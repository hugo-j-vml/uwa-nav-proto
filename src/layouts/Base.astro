---
import '@fontsource/inter/400.css';
import '@fontsource/crimson-pro/600.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';
import PrimaryNavHeader from '../components/PrimaryNavHeader.astro';
import Sidebar from '../components/Sidebar.astro';
import PaneHeader from '../components/PaneHeader.astro';
import PaneSidebar from '../components/PaneSidebar.astro';
import ControlHeader from '../components/ControlHeader.astro';
import PasswordGate from '../components/PasswordGate.astro';
import { PASSWORD_SHA256, PROTOTYPE_NAME } from '../config';
import { OPTIONS, OPTIONS_KEY, optionsFor } from '../options';
import { BREAKPOINTS, COMPACT } from '../breakpoints';
import OptionsPanel from '../components/OptionsPanel.astro';
import type { Variant } from '../variants';
import type { Cobrand } from '../lib/nav';

/** variant: the nav concept this page belongs to; omit for pages outside the variants (the index page) */
/** currentPath: sitemap path of this page (e.g. 'study-at-uwa/explore-courses'), used to open the menu at the right place */
/** transparentHeader: no grey band behind the header (homepage and landing pages, per Figma) */
/** cobrand: on a co-branded site's pages, the site (A, B, C header shows its logo next to UWA's; the menus use its IA for the co-brand menu options) */
interface Props { title: string; variant?: Variant; currentPath?: string; transparentHeader?: boolean; cobrand?: Cobrand }
const { title, variant, currentPath = '', transparentHeader = false, cobrand } = Astro.props;
// Behaviour options for this page: its variant's phase (the index page: all of them; CONTROL-1: none), and any the variant fixes
const pageOptions = (variant ? (variant.noOptions ? [] : optionsFor(variant.phase)) : OPTIONS).map(o => ({ id: o.id, d: o.default, c: o.choices.map(c => c.id) }));
const fixed = variant?.fixedOptions ?? {};
---
<!doctype html>
<html lang="en-AU" data-variant={variant?.id ?? 'index'} data-shell={variant?.shell}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{variant ? `${variant.letter} | ${title}` : `${title} | ${PROTOTYPE_NAME}`}</title>
    <!-- Lock the page before it paints unless the password was already entered in this browser (shared by all variants) -->
    <script is:inline define:vars={{ hash: PASSWORD_SHA256 }}>
      (function () {
        var ok = false;
        try { ok = localStorage.getItem('uwa-nav-proto-auth') === hash; } catch (e) {}
        if (!ok) document.documentElement.classList.add('is-locked');
      })();
    </script>
    <!-- Behaviour options (src/options.ts): apply the chosen ones before the page paints (only the
         options of this variant's phase, plus any the variant fixes, e.g. G and H's co-brand tabs).
         A link like ?cobrand-menu=7 sets and remembers a choice (then drops it from the address). -->
    <script is:inline define:vars={{ options: pageOptions, fixed, key: OPTIONS_KEY }}>
      (function () {
        var saved = {};
        try { saved = JSON.parse(localStorage.getItem(key) || '{}') || {}; } catch (e) {}
        var params = new URLSearchParams(location.search), changed = false;
        options.forEach(function (o) {
          var fromUrl = params.get(o.id);
          if (fromUrl && o.c.indexOf(fromUrl) !== -1) { saved[o.id] = fromUrl; changed = true; }
          params.delete(o.id);
          var v = o.c.indexOf(saved[o.id]) !== -1 ? saved[o.id] : o.d;
          document.documentElement.setAttribute('data-opt-' + o.id, v);
        });
        for (var id in fixed) document.documentElement.setAttribute('data-opt-' + id, fixed[id]);
        if (changed) try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {}
        // Drop the option from the address once remembered, so a later change (e.g. in the Shift+O panel) isn't undone on reload
        if (changed) { var q = params.toString(); history.replaceState(history.state, '', location.pathname + (q ? '?' + q : '') + location.hash); }
      })();
    </script>
    <!-- Breakpoints (src/breakpoints.ts): data-bp (mobile / tablet / desktop) and data-layout
         (compact / full) on <html>, set before the page paints and kept up to date on resize.
         A change of layout fires "layoutchange" on document (once settled), so the menus can reset. -->
    <script is:inline define:vars={{ bps: BREAKPOINTS, compact: COMPACT }}>
      (function () {
        var html = document.documentElement;
        var tablet = matchMedia('(min-width: ' + bps.tablet + 'px)');
        var desktop = matchMedia('(min-width: ' + bps.desktop + 'px)');
        var announced, timer;
        function apply() {
          var bp = desktop.matches ? 'desktop' : tablet.matches ? 'tablet' : 'mobile';
          var layout = compact.indexOf(bp) !== -1 ? 'compact' : 'full';
          html.dataset.bp = bp;
          html.dataset.layout = layout;
          if (!announced) { announced = layout; return; }
          // Tell the menus once the size has settled (a brief flip, e.g. while a window is dragged, is ignored)
          clearTimeout(timer);
          timer = setTimeout(function () {
            if (html.dataset.layout === announced) return;
            announced = html.dataset.layout;
            document.dispatchEvent(new CustomEvent('layoutchange'));
          }, 150);
        }
        apply();
        tablet.addEventListener('change', apply);
        desktop.addEventListener('change', apply);
      })();
    </script>
  </head>
  <body>
    <PasswordGate />
    {variant ? (
      <div class="site">
        {/* Variant shell: header across the top (A, B, C, F) or a fixed sidebar (D, E); phase 2's menu pane: G (header), H (sidebar); the live site's header: CONTROL-1 */}
        {variant.menu === 'mega' ? (
          <ControlHeader variant={variant.id} currentPath={currentPath} transparent={transparentHeader} cobrand={cobrand} more={variant.mega?.more ?? []} lockups={variant.mega?.lockups ?? []} />
        ) : variant.menu === 'pane' ? (
          variant.shell === 'header'
            ? <PaneHeader variant={variant.id} currentPath={currentPath} transparent={transparentHeader} cobrand={cobrand} />
            : <PaneSidebar variant={variant.id} currentPath={currentPath} cobrand={cobrand} />
        ) : (
          <>
            {variant.shell === 'header' && <PrimaryNavHeader variant={variant.id} menu={variant.menu} currentPath={currentPath} transparent={transparentHeader} cobrand={cobrand} />}
            {variant.shell === 'sidebar' && <Sidebar variant={variant.id} menu={variant.menu} currentPath={currentPath} cobrand={cobrand} />}
          </>
        )}
        <main class="page">
          <slot />
        </main>
        {!variant.noOptions && <OptionsPanel phase={variant.phase} />}
      </div>
    ) : (
      <slot />
    )}
  </body>
</html>
